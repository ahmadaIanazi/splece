{
  "name": "local-video-studio",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "build:website": "node scripts/website/build.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "studio": "node scripts/studio-launcher.mjs open",
    "install:macos": "node scripts/install-macos.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:demo": "node scripts/setup-demo.mjs",
    "format": "prettier --write src server tests scripts",
    "release:source": "node scripts/release/source.mjs",
    "release:package": "node scripts/release/package.mjs",
    "predev": "node scripts/prepare-vision.mjs",
    "prebuild": "node scripts/prepare-vision.mjs",
    "release:mac-beta": "node scripts/release/prepare-mac-beta.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
