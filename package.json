    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "ffmpeg-static": "^5.2.0"
  },
